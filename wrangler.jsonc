{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appss",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fbb63149-d999-4177-a58f-6fef73f6a645","database_name": "web-apps" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f5ba451d1a0944dc8b76c49689baf7e9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
